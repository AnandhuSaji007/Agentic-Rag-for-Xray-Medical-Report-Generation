import os
import pandas as pd
import nltk
from nltk.translate.bleu_score import sentence_bleu, SmoothingFunction
from nltk.translate.meteor_score import meteor_score
from rouge_score import rouge_scorer
from collections import Counter

# Download required NLTK resources (if not already available)
nltk.download('punkt')

# Define file paths
input_csv = "Path of the csv"  
output_csv = "./output_with_scores.csv"

# Read the CSV file
df = pd.read_csv(input_csv)

# Prepare lists to hold metrics for each row
bleu_scores, rouge1_scores, rouge2_scores, rougeL_scores = [], [], [], []
meteor_scores, precisions, recalls, f1s = [], [], [], []

# Setup smoothing for BLEU
smoothing = SmoothingFunction().method1

# Setup ROUGE scorer
scorer = rouge_scorer.RougeScorer(['rouge1', 'rouge2', 'rougeL'], use_stemmer=True)

# Iterate over each row to calculate metrics
for _, row in df.iterrows():
    # Get reference and hypothesis texts
    ref_text = row['report']
    hyp_text = row['genratedreport']

    # Tokenize texts
    ref_tokens = nltk.word_tokenize(ref_text.lower())
    hyp_tokens = nltk.word_tokenize(hyp_text.lower())

    # BLEU-4 Score
    bleu = sentence_bleu([ref_tokens], hyp_tokens, weights=(0.25, 0.25, 0.25, 0.25), smoothing_function=smoothing)
    bleu_scores.append(bleu)

    # ROUGE Scores
    rouge_scores = scorer.score(ref_text, hyp_text)
    rouge1_scores.append(rouge_scores['rouge1'].fmeasure)
    rouge2_scores.append(rouge_scores['rouge2'].fmeasure)
    rougeL_scores.append(rouge_scores['rougeL'].fmeasure)

    # METEOR Score
    meteor = meteor_score([ref_tokens], hyp_tokens)
    meteor_scores.append(meteor)

    # Precision, Recall, F1 Score using Counter
    ref_count = Counter(ref_tokens)
    hyp_count = Counter(hyp_tokens)
    common_count = sum(min(ref_count[word], hyp_count[word]) for word in ref_count.keys() & hyp_count.keys())

    precision = common_count / len(hyp_tokens) if hyp_tokens else 0
    recall = common_count / len(ref_tokens) if ref_tokens else 0
    f1 = (2 * precision * recall / (precision + recall)) if (precision + recall) > 0 else 0

    precisions.append(precision)
    recalls.append(recall)
    f1s.append(f1)

# Append computed metrics to DataFrame
df['BLEU-4'] = bleu_scores
df['ROUGE-1'] = rouge1_scores
df['ROUGE-2'] = rouge2_scores
df['ROUGE-L'] = rougeL_scores
df['METEOR'] = meteor_scores
df['Precision'] = precisions
df['Recall'] = recalls
df['F1'] = f1s

# Save output CSV
df.to_csv(output_csv, index=False)
print("Output CSV with scores saved as:", output_csv)

# Compute and print average metrics
print("\nAverage Scores:")
print("Average BLEU-4:", sum(bleu_scores) / len(bleu_scores))
print("Average ROUGE-1:", sum(rouge1_scores) / len(rouge1_scores))
print("Average ROUGE-2:", sum(rouge2_scores) / len(rouge2_scores))
print("Average ROUGE-L:", sum(rougeL_scores) / len(rougeL_scores))
print("Average METEOR:", sum(meteor_scores) / len(meteor_scores))
print("Average Precision:", sum(precisions) / len(precisions))
print("Average Recall:", sum(recalls) / len(recalls))
print("Average F1:", sum(f1s) / len(f1s))
